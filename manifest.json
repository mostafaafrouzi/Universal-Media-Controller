{
  "name": "Universal Media Controller",
  "version": "0.3.1",
  "manifest_version": 3,
  "description": "YouTube-style keyboard shortcuts for any video or audio. You choose which sites to allow — nothing is collected.",
  "homepage_url": "https://github.com/mostafaafrouzi/Universal-Media-Controller",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "default_locale": "en",
  "action": {
    "default_popup": "./src/popup/index.html",
    "default_title": "Universal Media Controller"
  },
  "background": {
    "service_worker": "./src/background.js"
  },
  "options_page": "src/options/index.html"
}
